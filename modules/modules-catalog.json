{
  "version": "2.0",
  "description": "AgentDock module registry v2 \u2014 detect, install, load",
  "modules": [
    {
      "id": "compound-engineering",
      "name": "Compound Engineering",
      "type": "plugin-pack",
      "tag": "Skills pack",
      "description": "39 CE skills (catalog) + 51 upstream review agents from EveryInc. Native on Claude Code and Codex; converter-backed on Gemini/OpenCode.",
      "source": "https://github.com/EveryInc/compound-engineering-plugin",
      "version": "3.11.2",
      "counts": {
        "skills": 39,
        "agents_catalog": 21,
        "agents_upstream": 51,
        "cached_skills": 9
      },
      "catalog": {
        "skills": "skills/compound-engineering/skills-catalog.json",
        "agents": "skills/compound-engineering/agents-catalog.json"
      },
      "cache_dir": "skills/compound-engineering/cache",
      "sync": {
        "script": "scripts/sync-ce-skills.js",
        "label": "Sync 9 core skills to local cache"
      },
      "install": {
        "note": "Full setup syncs cache, then installs into every detected frontend. Codex still needs /plugins TUI install for native skills after marketplace + agents steps.",
        "targets": {
          "claude_marketplace": {
            "label": "Claude \u2014 add marketplace",
            "command": "claude",
            "args": [
              "plugin",
              "marketplace",
              "add",
              "EveryInc/compound-engineering-plugin"
            ],
            "requires_frontend": "claude",
            "runnable": true
          },
          "claude_plugin": {
            "label": "Claude \u2014 install plugin",
            "command": "claude",
            "args": [
              "plugin",
              "install",
              "compound-engineering"
            ],
            "requires_frontend": "claude",
            "runnable": true
          },
          "codex_marketplace": {
            "label": "Codex \u2014 register marketplace",
            "command": "codex",
            "args": [
              "plugin",
              "marketplace",
              "add",
              "EveryInc/compound-engineering-plugin"
            ],
            "requires_frontend": "codex",
            "runnable": true
          },
          "codex_agents": {
            "label": "Codex \u2014 install review agents (bunx)",
            "command": "bunx",
            "args": [
              "@every-env/compound-plugin",
              "install",
              "compound-engineering",
              "--to",
              "codex"
            ],
            "requires_frontend": "codex",
            "requires_tool": "node",
            "runnable": true,
            "optional": true,
            "next_steps": [
              "Launch codex, run /plugins, install compound-engineering, restart Codex"
            ]
          },
          "codex_tui": {
            "label": "Codex \u2014 TUI plugin install (manual)",
            "command": "codex",
            "args": [],
            "requires_frontend": "codex",
            "runnable": false,
            "manual_only": true,
            "manual_note": "Launch codex \u2192 /plugins \u2192 Compound Engineering marketplace \u2192 install compound-engineering \u2192 restart Codex."
          },
          "gemini_convert": {
            "label": "Gemini CLI \u2014 converter install",
            "command": "bunx",
            "args": [
              "@every-env/compound-plugin",
              "install",
              "compound-engineering",
              "--to",
              "gemini"
            ],
            "requires_frontend": "gemini",
            "requires_tool": "node",
            "runnable": true,
            "optional": true
          }
        }
      },
      "detect": {
        "cache_min_files": 1,
        "frontends": [
          "claude",
          "codex",
          "gemini"
        ]
      },
      "default_enabled": true
    },
    {
      "id": "mcp-git",
      "name": "MCP Git",
      "type": "mcp-server",
      "tag": "MCP",
      "description": "Read-only Git repository tools for agents \u2014 safer than raw shell for diff/log/blame workflows.",
      "source": "https://github.com/modelcontextprotocol/servers/tree/main/src/git",
      "risk_tier": "low",
      "mcp_id": "git",
      "requires": [
        "uvx",
        "git"
      ],
      "install_snippet": "uvx mcp-server-git --repository <REPO_PATH>",
      "default_enabled": true
    },
    {
      "id": "mcp-fetch",
      "name": "MCP Fetch",
      "type": "mcp-server",
      "tag": "MCP",
      "description": "Fetch web pages as markdown for grounded agent context. Medium risk \u2014 enables network access.",
      "source": "https://github.com/modelcontextprotocol/servers/tree/main/src/fetch",
      "risk_tier": "medium",
      "mcp_id": "fetch",
      "requires": [
        "uvx"
      ],
      "install_snippet": "uvx mcp-server-fetch",
      "default_enabled": false
    },
    {
      "id": "agentdock-coach",
      "name": "HOOT Coach",
      "type": "builtin",
      "tag": "Built-in",
      "description": "Screen-aware ops owl \u2014 contextual hints, error surfacing, and local/cloud coach chat on every view.",
      "always_on": true,
      "default_enabled": true
    },
    {
      "id": "agentdock-audit",
      "name": "Launch Audit",
      "type": "builtin",
      "tag": "Built-in",
      "description": "Pre-launch compatibility gate \u2014 model tier vs task, CE frontend checks, and alternative profile suggestions.",
      "always_on": true,
      "default_enabled": true
    },
    {
      "id": "agentdock-key-vault",
      "name": "Key Vault",
      "type": "builtin",
      "tag": "Built-in",
      "description": "Auto-import API keys from scan/.env into state/key-vault.json; injects into launches and stack health checks.",
      "always_on": true,
      "default_enabled": true
    },
    {
      "id": "agentdock-stack-builder",
      "name": "Stack Builder",
      "type": "builtin",
      "tag": "Built-in",
      "description": "Guided stack composer with Google/Gemma/Grok templates, health scoring, and profile export.",
      "always_on": true,
      "default_enabled": true
    },
    {
      "id": "provider-ride",
      "name": "ProviderRide",
      "type": "capability-layer",
      "tag": "Providers",
      "description": "ProviderRide — private multi-backend provider doctor + HITL Account Booth + AES-GCM credentials for AI tool/LLM accounts. Standalone package at ../provider-ride; limited power (no general web agent).",
      "source": "local:../provider-ride",
      "version": "0.2.0",
      "host_bridge": "provider-ride-host.js",
      "api": [
        "GET /api/providers/doctor",
        "GET /api/providers/ride/meta",
        "GET /api/providers/booth",
        "POST /api/providers/booth/open",
        "GET/POST /api/providers/credentials"
      ],
      "risk_tier": "medium",
      "policy": "Mutations require HITL; doctor is read-only",
      "default_enabled": true,
      "always_on": true
    },
    {
      "id": "cooldown-command-deck",
      "name": "Cooldown Command Deck",
      "type": "builtin",
      "tag": "Built-in",
      "description": "Live provider cooldown gauges, recovery timeline, workspace context radar, and one-click save-state handoffs. Top-bar strip + always-on-top popout monitor.",
      "always_on": true,
      "default_enabled": true
    }
  ]
}